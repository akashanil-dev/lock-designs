[Unit]
Description=Lenovo ToF presence event publisher
After=systemd-udev-settle.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/omarchy-presence/sensor.py serve --uid 1000
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
RuntimeDirectory=omarchy-presence
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/sys/devices /run/omarchy-presence
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_CHOWN
MemoryMax=64M
TasksMax=8
LimitCORE=0
MemoryAccounting=yes

[Install]
WantedBy=multi-user.target
